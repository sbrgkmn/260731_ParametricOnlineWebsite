# Public site URL used for canonical links, sitemaps, and social metadata.
NEXT_PUBLIC_SITE_URL=https://parametric.online

# One configurable brand accent.
NEXT_PUBLIC_ACCENT_COLOR=#ff4d00

# Hosted integrations. Replace the sample defaults before launch.
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Parametric
NEXT_PUBLIC_SKOOL_URL=https://www.skool.com/parametric-lab
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/parametric-online
NEXT_PUBLIC_NEWSLETTER_URL=https://buttondown.com/parametriconline
NEXT_PUBLIC_CONTACT_EMAIL=hello@parametric.online

# Session pricing and optional session-specific booking links.
NEXT_PUBLIC_SESSION_DIAGNOSTIC_PRICE=$145
NEXT_PUBLIC_SESSION_CLINIC_PRICE=$285
NEXT_PUBLIC_SESSION_INTENSIVE_PRICE=$560
NEXT_PUBLIC_SESSION_DIAGNOSTIC_URL=https://calendly.com/parametric-online
NEXT_PUBLIC_SESSION_CLINIC_URL=https://calendly.com/parametric-online
NEXT_PUBLIC_SESSION_INTENSIVE_URL=https://calendly.com/parametric-online

